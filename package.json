{
  "name": "bdt-connect",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @bdt/api db:migrate",
    "db:seed": "pnpm --filter @bdt/api db:seed",
    "api:dev": "pnpm --filter @bdt/api dev",
    "mobile:dev": "pnpm --filter @bdt/mobile dev",
    "web:dev": "pnpm --filter @bdt/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.6.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.61.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "body-parser": "1.20.6",
      "brace-expansion@^1.0.0": "1.1.18",
      "brace-expansion@^2.0.0": "2.1.4",
      "brace-expansion@^5.0.0": "5.0.9",
      "esbuild": "0.28.1",
      "fast-xml-parser": "5.7.0",
      "js-yaml@^3.0.0": "3.15.1",
      "js-yaml@^4.0.0": "4.3.1",
      "joi": "18.2.1",
      "nanoid@^3.0.0": "3.3.17",
      "postcss": "8.5.26",
      "qs": "6.15.2",
      "shell-quote": "1.10.0",
      "tar": "7.5.22",
      "undici@^6.0.0": "6.28.0",
      "undici@^7.0.0": "7.29.0",
      "uuid": "11.1.1",
      "vite": "7.3.5",
      "ws@^6.0.0": "6.2.4",
      "ws@^7.0.0": "7.5.11",
      "ws@^8.0.0": "8.21.3"
    }
  }
}
